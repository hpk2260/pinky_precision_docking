    <!-- Shelf 1: Costco-Style Industrial Heavy Pallet Rack      -->
    <!-- (Steel Blue Posts, Safety Orange Beams, 2-Tier Cargo)    -->
    <!-- ArUco IDs 6, 7, 8 Mount Directly to Front Load Beam      -->
    <!-- ======================================================== -->
        <!-- ======================================================== -->
    <!-- Shelf 1: 3 Costco Pallet Racks Side-by-Side (Height 0.25m)-->
    <!-- Matching Outer Wall Height exactly (z in [0.0, 0.25m])   -->
    <!-- ArUco IDs 6, 7, 8 Mount on Lower Front Load Beams        -->
    <!-- ======================================================== -->
    <!-- Shelf 1: 3 Costco Pallet Racks Side-by-Side (Height 0.25m)-->
    <!-- Matching Outer Wall Height exactly (z in [0.0, 0.25m])   -->
