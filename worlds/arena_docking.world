<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gui fullscreen="0">
      <camera name="user_camera">
        <!-- Overhead view of the entire 1.5m x 2.25m arena -->
        <pose>0.60 0.80 2.80 0.0 1.25 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0.6 0.8 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.42 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- ========================================== -->
    <!-- Office Ceiling Lighting (1m Grid at z = 2.5m) -->
    <!-- ========================================== -->
    <light type="point" name="office_light_grid_0">
      <cast_shadows>false</cast_shadows>
      <pose>0.10 -0.22 2.50 0 0 0</pose>
      <diffuse>0.72 0.72 0.75 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>6.0</range>
        <constant>0.6</constant>
        <linear>0.15</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
    </light>
