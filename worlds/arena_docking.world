      <static>true</static>
      <pose>-0.0800 1.2300 0.1250 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.0700 0.2300 0.2500</size></box></geometry>
        </collision>
        <!-- Blue Upright Posts (Height 0.25m) -->
        <visual name="post_FL"><pose>0.0300 -0.110 0 0 0 0</pose><geometry><box><size>0.015 0.015 0.25</size></box></geometry><material><ambient>0.05 0.15 0.45 1</ambient><diffuse>0.08 0.25 0.65 1</diffuse><specular>0.3 0.3 0.4 1</specular></material></visual>
        <visual name="post_FR"><pose>0.0300 0.110 0 0 0 0</pose><geometry><box><size>0.015 0.015 0.25</size></box></geometry><material><ambient>0.05 0.15 0.45 1</ambient><diffuse>0.08 0.25 0.65 1</diffuse><specular>0.3 0.3 0.4 1</specular></material></visual>
        <visual name="post_RL"><pose>-0.0300 -0.110 0 0 0 0</pose><geometry><box><size>0.015 0.015 0.25</size></box></geometry><material><ambient>0.05 0.15 0.45 1</ambient><diffuse>0.08 0.25 0.65 1</diffuse><specular>0.3 0.3 0.4 1</specular></material></visual>
        <visual name="post_RR"><pose>-0.0300 0.110 0 0 0 0</pose><geometry><box><size>0.015 0.015 0.25</size></box></geometry><material><ambient>0.05 0.15 0.45 1</ambient><diffuse>0.08 0.25 0.65 1</diffuse><specular>0.3 0.3 0.4 1</specular></material></visual>
        <!-- Orange Lower Beams (Backing for ArUco ID 6 at X=-0.039m) -->
        <visual name="beam_LF"><pose>0.0320 0 -0.057 0 0 0</pose><geometry><box><size>0.012 0.21 0.035</size></box></geometry><material><ambient>0.6 0.2 0.02 1</ambient><diffuse>0.88 0.32 0.04 1</diffuse><specular>0.4 0.2 0.1 1</specular></material></visual>
